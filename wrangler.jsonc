{
  // Assets-only Worker: no `main`, so Cloudflare serves the exported site
  // straight from static assets. Committing this file also stops `wrangler
  // deploy` from running its Next.js auto-setup, which rewrites the project to
  // the OpenNext adapter.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "erikgoins",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
